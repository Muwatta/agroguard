DEBUG=True
CAMERA_URL=http://10.35.236.252:8080/video
UPLOAD_DIR=backend/static/captures


# AgroGuard Environment Config
# Copy this file to .env and fill in your values.
# .env is gitignored — never commit it.

# ── Camera ────────────────────────────────────────────────────────────────────
# Hackathon demo: set to your laptop stream URL
# PHONE_CAM_URL=http://192.168.x.x:8080/video
# Pi Camera Module or USB cam:
PHONE_CAM_URL=0

# ── Arduino Serial ────────────────────────────────────────────────────────────
# Windows: COM3, COM4, etc.  |  Pi/Linux: /dev/ttyUSB0 or /dev/ttyACM0
SERIAL_PORT=/dev/ttyUSB0
BAUD_RATE=9600

# ── AI Model ─────────────────────────────────────────────────────────────────
MODEL_PATH=pest_model.tflite
CONF_THRESHOLD=0.65
IMG_SIZE=224

# ── GPIO ─────────────────────────────────────────────────────────────────────
DETERRENT_PIN=17
DETERRENT_SECS=3

# ── Flask ─────────────────────────────────────────────────────────────────────
FLASK_PORT=5000
